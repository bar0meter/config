{
    "editor.fontSize": 14,
    "editor.fontFamily": "JetBrains Mono NL",
    "terminal.integrated.fontSize": 14,
    "window.zoomLevel": 0.4,
    "editor.lineHeight": 1.3,

    "accessibility.dimUnfocused.enabled": false,
    "window.title": "${rootPath}",
    "outline.showVariables": false,
    "breadcrumbs.showVariables": false,
    "editor.accessibilitySupport": "off",
    "editor.codeLens": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "block",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.hover.enabled": "off",
    "editor.minimap.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.renderWhitespace": "none",
    "editor.roundedSelection": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.tabCompletion": "onlySnippets",
    "editor.inlineSuggest.enabled": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    // small gutter
    // "editor.folding": false,
    "editor.lineDecorationsWidth": 0, // undocumented
    "editor.lineNumbers": "off",
    "editor.lineNumbersMinChars": 0, // undocumented
    "editor.glyphMargin": false,
    "editor.guides.indentation": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.openEditors.visible": 1,
    "extensions.ignoreRecommendations": true,
    "extensions.verifySignature": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 100,
    "files.enableTrash": true,
    "files.hotExit": "off",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "terminal.integrated.sendKeybindingsToShell": false,
    "terminal.integrated.commandsToSkipShell": [
        "language-julia.interrupt",
        "editor.action.marker.nextInFiles"
    ],
    "update.mode": "none",
    "update.showReleaseNotes": false,
    "git.alwaysShowStagedChangesResourceGroup": true,
    "git.autoRepositoryDetection": "openEditors",
    "git.openRepositoryInParentFolders": "always",
    "debug.onTaskErrors": "debugAnyway",
    "errorLens.excludeByMessage": [
        ".*Unknown word.*"
    ],
    "rust-analyzer.completion.callable.snippets": "add_parentheses",
    "rust-analyzer.callInfo": false,
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.server.extraEnv": {
        // "RA_PROFILE": "*>16",
        // "RA_LOG": "rust_analyzer=info",
        // "RA_COUNT": "1"
    },
    "rust-analyzer.runnables.problemMatcher": [
        "$rustc",
        "$rust-panic"
    ],
    "rust-analyzer.testExplorer": true,
    "rust-analyzer.runnables.extraTestBinaryArgs": [
        "--nocapture"
    ],
    "workbench.colorCustomizations": {
        "scrollbar.shadow": "#00000000",
        "widget.shadow": "#00000000"
    },
    "python.languageServer": "Pylance",
    "python.showStartPage": false,
    "julia.enableTelemetry": true,
    "julia.lint.run": false,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook",
        "git-rebase-todo": "default"
    },
    "workbench.colorTheme": "Pale Fire High Contrast",
    "workbench.settings.editor": "json",
    "workbench.editor.useModal": "off",
    "vim.leader": ",",
    "vim.useSystemClipboard": true,
    "vim.insertModeKeyBindings": [
        {
            "before": ["j", "k"],
            "after": ["<Esc>"]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "l"],
            "commands": ["workbench.action.quickOpen"]
        },
        {
            "before": ["<leader>", "b"],
            "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"]
        },
        {
            "before": ["g", "r", "r"],
            "commands": ["editor.action.goToReferences"]
        },
        {
            "before": ["g", "d"],
            "commands": ["editor.action.goToTypeDefinition"]
        },
        {
            "before": ["g", "D"],
            "commands": ["editor.action.revealDefinition"]
        },
        {
            "before": ["g", "I"],
            "commands": ["editor.action.goToImplementation"]
        },
        {
            "before": ["K"],
            "commands": ["editor.action.showHover"]
        },
        {
            "before": ["<leader>", "r", "n"],
            "commands": ["editor.action.rename"]
        },
        {
            "before": ["<leader>", "c", "a"],
            "commands": ["editor.action.quickFix"]
        },
        {
            "before": ["<leader>", "d", "s"],
            "commands": ["workbench.action.gotoSymbol"]
        },
        {
            "before": ["<leader>", "h"],
            "commands": ["editor.action.toggleInlayHints"]
        },
        {
            "before": ["<leader>", "k"],
            "commands": ["workbench.actions.view.problems"]
        }
    ],
    "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-auto",
    "workbench.editor.showTabs": "none",
    "workbench.editor.labelFormat": "long",
    "workbench.editor.enablePreview": true,
    "workbench.panel.defaultLocation": "right",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.statusBar.feedback.visible": false,
    "workbench.tree.indent": 16,
    "workbench.useExperimentalGridLayout": true,
}
